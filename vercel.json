      "destination": "/capitulos/vts/index.html"
    },
    {
      "source": "/capitulos/wie",
      "destination": "/capitulos/wie/index.html"
    },
    {
      "source": "/en/historia",
      "destination": "/en/historia/index.html"
    },
    {
      "source": "/en/projetos",
      "destination": "/en/projetos/index.html"
    },
    {
      "source": "/en/oportunidades",
      "destination": "/en/oportunidades/index.html"
    },
    {
      "source": "/en/capitulos/aess",
      "destination": "/en/capitulos/aess/index.html"
    },
    {
      "source": "/en/capitulos/aps",

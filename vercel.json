{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "headers": [
    {
      "source": "/api/drive-image",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=2592000"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=604800, stale-while-revalidate=2592000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/en",
      "destination": "/en.html"
    },
    {
      "source": "/historia",
      "destination": "/historia/index.html"
    },
    {
      "source": "/projetos",
      "destination": "/projetos/index.html"
    },
    {
      "source": "/oportunidades",
      "destination": "/oportunidades/index.html"
    },
    {
      "source": "/capitulos/aess",
      "destination": "/capitulos/aess/index.html"
    },
    {
      "source": "/capitulos/aps",
      "destination": "/capitulos/aps/index.html"
    },
    {
      "source": "/capitulos/comsoc",
      "destination": "/capitulos/comsoc/index.html"
    },
    {
      "source": "/capitulos/cs",
      "destination": "/capitulos/cs/index.html"
    },
    {
      "source": "/capitulos/cas",
      "destination": "/capitulos/cas/index.html"
    },
    {
      "source": "/capitulos/edsoc",
      "destination": "/capitulos/edsoc/index.html"
    },
    {
      "source": "/capitulos/ias",
      "destination": "/capitulos/ias/index.html"
    },
    {
      "source": "/capitulos/pes",
      "destination": "/capitulos/pes/index.html"
    },
    {
      "source": "/capitulos/ras",
      "destination": "/capitulos/ras/index.html"
    },
    {
      "source": "/capitulos/sight",
      "destination": "/capitulos/sight/index.html"
    },
    {
